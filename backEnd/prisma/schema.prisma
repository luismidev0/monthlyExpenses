generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model expensives {
  id Int @id @default(autoincrement())
  title String
  description String? 
  value Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
